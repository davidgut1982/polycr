# polycr environment configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Supported: anthropic | openai | openrouter | groq
LLM_PROVIDER=anthropic

# API key for the chosen provider
LLM_API_KEY=your-key-here

# Model name for the chosen provider.
# Anthropic examples:
LLM_MODEL=claude-haiku-4-5-20251001
# LLM_MODEL=claude-sonnet-4-5-20251001

# OpenAI example:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o

# OpenRouter (cheap Qwen vision model):
# LLM_PROVIDER=openrouter
# LLM_MODEL=qwen/qwen2.5-vl-72b-instruct

# Groq example:
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.2-11b-vision-preview

# ── Engine Selection ───────────────────────────────────────────────────────────
# Comma-separated list of engines the router will fan out to.
# Available: tesseract, easyocr, doctr, paddleocr, surya
# Note: paddleocr and surya require the "full" Docker Compose profile.
ENABLED_ENGINES=tesseract,easyocr,doctr

# ── Network ───────────────────────────────────────────────────────────────────
# Host port the router is published on.
PORT=8000
