FROM paddlepaddle/paddle:3.3.1-gpu-cuda12.6-cudnn9.5

ENV DEBIAN_FRONTEND=noninteractive \
    PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True \
    FLAGS_check_nan_inf=0

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 libglib2.0-0 libsm6 libxext6 libxrender1 libgl1 wget \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    paddleocr==3.5.0 \
    fastapi==0.104.1 \
    "uvicorn[standard]==0.24.0" \
    python-multipart==0.0.6 \
    numpy \
    pillow

ARG BOS_BASE=https://paddle-model-ecology.bj.bcebos.com/paddlex/official_inference_model/paddle3.0.0
ARG MODEL_DIR=/root/.paddlex/official_models

RUN mkdir -p "${MODEL_DIR}"

RUN set -eux; \
    cd "${MODEL_DIR}"; \
    for MODEL in \
        PP-LCNet_x1_0_doc_ori \
        UVDoc \
        PP-OCRv5_server_det \
        PP-LCNet_x1_0_textline_ori \
        en_PP-OCRv5_mobile_rec; \
    do \
        echo "[build] Downloading ${MODEL}..."; \
        wget -q "${BOS_BASE}/${MODEL}_infer.tar" -O "${MODEL}_infer.tar"; \
        tar -xf "${MODEL}_infer.tar"; \
        rm "${MODEL}_infer.tar"; \
        if [ -d "${MODEL}_infer" ] && [ ! -d "${MODEL}" ]; then \
            mv "${MODEL}_infer" "${MODEL}"; \
        fi; \
        echo "[build] ${MODEL} done"; \
    done

COPY verify_models.py /tmp/verify_models.py
RUN python3 /tmp/verify_models.py

WORKDIR /app
COPY main.py /app/main.py

EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
